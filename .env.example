# Copia este archivo como .env.local (en local) o define estas variables en tu hosting.
# .env.local estÃ¡ en .gitignore: las claves reales nunca se suben al repositorio.

# URL pÃºblica del sitio (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://majo.studio

# â”€â”€ Formulario de contacto: envÃ­o por email con Resend (https://resend.com) â”€â”€
# Clave secreta de Resend (empieza por "re_"). Solo se usa en el servidor.
RESEND_API_KEY=
# Correo que recibe las solicitudes. Para varios destinatarios, sepÃ¡ralos con comas.
CONTACT_TO_EMAIL=proyectos@majostudio.es
# Remitente. Mientras no verifiques tu dominio en Resend, deja el de pruebas
# (solo puede enviar al email con el que creaste la cuenta de Resend).
# Con dominio verificado: CONTACT_FROM_EMAIL=MAJO <web@tudominio.com>
CONTACT_FROM_EMAIL=MAJO <onboarding@resend.dev>

# Opcional: copia adicional de cada solicitud a un webhook (Slack, Make, Zapier, n8n, CRM...)
CONTACT_WEBHOOK_URL=
